{
  "name": "lanforge-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "concurrently -n \"SERVER,APP\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:server\" \"npm run dev:app\"",
    "dev": "npm run start",
    "dev:server": "npm --workspace=packages/server run dev",
    "build:server": "npm --workspace=packages/server run build",
    "test:server": "npm --workspace=packages/server run test",
    "dev:app": "npm --workspace=packages/app run dev",
    "build:app": "npm --workspace=packages/app run build",
    "tauri:dev": "npm --workspace=packages/app run tauri:dev",
    "tauri:build": "npm --workspace=packages/app run tauri:build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "keywords": [
    "p2p",
    "lan",
    "gaming",
    "virtual-network",
    "radmin-alternative"
  ],
  "author": "LANForge Team",
  "license": "MIT"
}
